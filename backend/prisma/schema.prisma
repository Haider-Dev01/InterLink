generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                 String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  email              String         @unique
  passwordHash       String
  role               Role
  isVerified         Boolean        @default(false)
  isBanned           Boolean        @default(false)
  companyId          String?
  location           String?
  availabilityMonths Int?
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  deletedAt          DateTime?      @db.Timestamptz(6)
  applications       Application[]  @relation("CandidateApplications")
  auditLogs          AuditLog[]
  company            Company?       @relation("CompanyRecruiters", fields: [companyId], references: [id], onUpdate: NoAction)
  ownedCompany       Company?       @relation("CompanyOwner")
  cvDocuments        CvDocument[]
  jobOffers          JobOffer[]
  match_scores       MatchScore[]
  receivedMessages   Message[]      @relation("ReceivedMessages")
  sentMessages       Message[]      @relation("SentMessages")
  sentConnections    Connection[]   @relation("ConnectionRequester")
  receivedConnections Connection[]  @relation("ConnectionReceiver")
  notifications      Notification[]
  profile            Profile?
  refreshTokens      RefreshToken[]
  chatMessages       ChatMessage[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("refresh_tokens")
}

model Profile {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String   @unique
  companyId      String?
  schoolId       String?
  firstName      String
  lastName       String
  bio            String?
  avatarUrl      String?  @map("avatar_url")
  viewsCount     Int      @default(0) @map("views_count")
  linkedinUrl    String?
  githubUsername String?
  githubData     Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  company        Company? @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  school         School?  @relation(fields: [schoolId], references: [id], onUpdate: NoAction)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("profiles")
}

model Company {
  id             String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String     @unique
  name           String
  industry       String?
  siteWeb        String?
  isVerified     Boolean    @default(false)
  isRejected     Boolean    @default(false)
  rejectedReason String?
  validatedAt    DateTime?  @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  deletedAt      DateTime?  @db.Timestamptz(6)
  user           User       @relation("CompanyOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recruiters     User[]     @relation("CompanyRecruiters")
  jobOffers      JobOffer[]
  profiles       Profile[]

  @@map("companies")
}

model School {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String    @unique
  country   String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  profiles  Profile[]

  @@map("schools")
}

model Skill {
  id              String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  name            String           @unique
  category        String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  extractedSkills ExtractedSkill[]
  offerSkills     OfferSkill[]

  @@map("skills")
}

model CvDocument {
  id              String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId          String
  fileUrl         String
  isActive        Boolean                @default(true)
  embedding       Unsupported("vector")?
  importedFrom    ImportedFrom           @default(upload)
  parseStatus     ParseStatus            @default(pending)
  parsedText      String?
  retryCount      Int                    @default(0)
  lastAttemptAt   DateTime?              @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  extractedSkills ExtractedSkill[]
  matchScores     MatchScore[]

  @@index([embedding], map: "idx_cv_embedding")
  @@map("cv_documents")
}

model ExtractedSkill {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  cvDocumentId String
  skillId      String
  confidence   Float?
  cvDocument   CvDocument @relation(fields: [cvDocumentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cvDocumentId, skillId])
  @@map("extracted_skills")
}

model JobOffer {
  id             String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  companyId      String
  recruiterId    String
  title          String
  description    String
  location       String?
  durationMonths Int?
  remote         Boolean                @default(false)
  offerStatus    OfferStatus            @default(draft)
  embedding      Unsupported("vector")?
  viewCount      Int                    @default(0)
  publishedAt    DateTime?              @db.Timestamptz(6)
  expiresAt      DateTime?              @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?              @db.Timestamptz(6)
  applications   Application[]
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recruiter      User                   @relation(fields: [recruiterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  matchScores    MatchScore[]
  offerSkills    OfferSkill[]

  @@index([embedding], map: "idx_offer_embedding")
  @@index([offerStatus], map: "idx_offers_status")
  @@map("job_offers")
}

model OfferSkill {
  offerId    String
  skillId    String
  isRequired Boolean  @default(true)
  offer      JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([offerId, skillId])
  @@map("offer_skills")
}

model MatchScore {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  candidateId  String
  offerId      String
  cvDocumentId String
  scoreCosinus Float
  scoreFinal   Float
  breakdown    Json
  computedAt   DateTime   @default(now()) @db.Timestamptz(6)
  users        User       @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cvDocument   CvDocument @relation(fields: [cvDocumentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  offer        JobOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([candidateId, offerId])
  @@index([offerId, scoreFinal(sort: Desc)], map: "idx_match_offer_score")
  @@map("match_scores")
}

model Application {
  id                String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  candidateId       String
  offerId           String
  applicationStatus ApplicationStatus @default(pending)
  coverLetter       String?
  appliedAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  candidate         User              @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  offer             JobOffer          @relation(fields: [offerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages          Message[]

  @@unique([candidateId, offerId])
  @@index([offerId, applicationStatus], map: "idx_applications_composite")
  @@map("applications")
}

model Message {
  id            String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  senderId      String
  receiverId    String
  applicationId String?
  content       String
  isRead        Boolean      @default(false)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  application   Application? @relation(fields: [applicationId], references: [id], onUpdate: NoAction)
  receiver      User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender        User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("messages")
}

model Connection {
  id          String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(pending)
  respondedAt DateTime?        @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requesterId, receiverId], map: "connections_requester_receiver_unique")
  @@index([requesterId, status], map: "idx_connections_requester_status")
  @@index([receiverId, status], map: "idx_connections_receiver_status")
  @@map("connections")
}

model Notification {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  type      String
  title     String
  payload   Json
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onUpdate: NoAction)

  @@map("audit_logs")
}

enum Role {
  candidate
  recruiter
  admin
}

enum OfferStatus {
  draft
  published
  archived
}

enum ApplicationStatus {
  pending
  interview
  accepted
  rejected
  withdrawn
}

enum ParseStatus {
  pending
  processing
  done
  failed
}

enum ImportedFrom {
  upload
  json
  github
}

enum ConnectionStatus {
  pending
  accepted
  rejected
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String   // "user" ou "assistant"
  content   String
  context   Json?    // pour stocker les métadonnées du RAG (optionnel)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}
